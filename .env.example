# Copy to .env and fill in. .env is not committed: it holds secrets.

# Required. Any long random string; make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# The database. With Docker Compose these create the database; without it, they say where yours is
# (DB_HOST and DB_PORT as well, which default to 127.0.0.1 and 5432).
DB_NAME=
DB_USER=
DB_PASS=

# Docker Compose only
# WEB_PORT=8000
# ALLOWED_HOSTS=localhost,127.0.0.1

# Email, for registration requests, their approval, and password resets. Leave empty to run
# without; see "Email" in the README. For Gmail, EMAIL_HOST_PASSWORD is an App Password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Must be of the form "('Full name', 'email address')"
ROGUEDB_MANAGERS=
ROGUEDB_ADMIN=