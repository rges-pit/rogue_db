# Copy to .env and fill in. .env is not committed: it holds secrets.

################################
# REQUIRED PARAMETERS

# Django secret key; used for cryptographic functions in the database
# Any long random string; make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# The database. With Docker Compose these create it, and a blank means the default (shown); without
# Docker, they say where yours is, and DB_HOST and DB_PORT as well (127.0.0.1 and 5432 if blank).
DB_NAME=rogue_tom_db
DB_USER=postgres
# Blank is "postgres" in Docker, and no password otherwise.  It's OK to leave this empty
DB_PASS=

################################
# OPTIONAL PARAMETERS
#
# It's OK to leave these parameters as they are unless you want to configure
# user email registration

# Docker Compose only
# WEB_PORT=8000
# ALLOWED_HOSTS=localhost,127.0.0.1

# Email, for registration requests, their approval, and password resets. Leave empty to run
# without; see "Email" in the README. For Gmail, EMAIL_HOST_PASSWORD is an App Password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Must be of the form "('Full name', 'email address')"
ROGUEDB_MANAGERS=
ROGUEDB_ADMIN=